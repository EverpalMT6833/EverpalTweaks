              <property name="styleSheet">
               <string notr="true">/*-----QCheckBox-----*/
QCheckBox{
	background-color: transparent;
	font-weight: bold;
	color: #fff;

}


QCheckBox::indicator
{
    color: #b1b1b1;
    background-color: rgb(72, 76, 88);
    border: 2px solid rgb(163, 167, 178);
    width: 12px;
    height: 12px;
	border-radius: 8px;

}


QCheckBox::indicator:checked
{
    border: 1px solid #323232;
	border-radius: 7px;
	background-color: rgb(255, 201, 38);
}


QCheckBox::indicator:unchecked:hover
{
    border: 2px solid rgb(255, 201, 38);

}


QCheckBox::disabled
{
	color: #656565;

}


